BOT_TOKEN=
DB_PASSWORD=
# необязательно: ключ OpenRouter для подсказки категории, если по истории не угадали
# (openrouter.ai/keys). Без него бот работает, но без ИИ
OPENROUTER_API_KEY=
# необязательно: модель (по умолчанию бесплатный роутер openrouter/free)
# OPENROUTER_MODEL=openai/gpt-oss-20b
# необязательно: true разрешает провайдерам хранить промпты. По умолчанию запрещено,
# но тогда бесплатной модели может не найтись
# OPENROUTER_ALLOW_DATA_COLLECTION=true
