BOT_TOKEN=
DB_PASSWORD=
# необязательно: ключ Groq для подсказки категории, если по истории не угадали
# (бесплатный ключ на console.groq.com). Без него бот работает, но без ИИ
GROQ_API_KEY=
# необязательно: Telegram id чата, куда бот пересылает отзывы из /feedback
# (свой id можно узнать у @userinfobot). Без него приём отзывов выключен
ADMIN_CHAT_ID=
